# Optional Open AI Provider Keys
# NatureBuddy AI runs 100% locally out-of-the-box without keys using the Browser-Local Open Model.

# Groq Open-Weight API (Qwen 3.8 27B Multimodal Vision)
# Keep GROQ_API_KEY as a backend server environment variable (NEVER prefix with VITE_)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# Hugging Face Serverless API (Qwen2-VL-7B-Instruct)
VITE_HF_API_KEY=

# Local Ollama URL (Default: http://localhost:11434)
VITE_OLLAMA_URL=http://localhost:11434

# Python FastAPI Backend URL (Local: http://localhost:8000 | Production: https://touchgrass-g7bd.onrender.com)
VITE_FASTAPI_URL=http://localhost:8000

# BirdNET Audio AI Configuration (Backend server environment variables - NEVER expose secrets in frontend)
# BIRDNET_API_URL=http://localhost:8080/analyze
# BIRDNET_API_KEY=

